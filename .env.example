# ============================================================
# Variables de entorno para cine-api
# ============================================================
# Copia este archivo como .env y reemplaza los valores:
#   cp .env.example .env
#
# ⚠️ IMPORTANTE: El archivo .env NO se sube a GitHub (está en .gitignore)
# ============================================================

# --- URI de conexión a MongoDB Atlas ---
# Obtén tu URI desde: MongoDB Atlas → Database → Connect → Drivers
# Reemplaza <usuario>, <password> y <cluster> con tus datos reales
MONGODB_URI=mongodb+srv://eva3_express:ubXMgx6hCoXdvoFb@cluster-express.egphtbu.mongodb.net/cine_db?appName=cluster-express
# --- Puerto del servidor (opcional) ---
# En Render se asigna automáticamente, en local usa 3000 por defecto
PORT=3000
